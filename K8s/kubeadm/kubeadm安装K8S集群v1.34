f.配置keepalived

将10.204.51.120转移到keepalived vip
ip addr del 10.204.51.120 dev eth0
10.204.51.112

yum install -y keepalived
cat /etc/keepalived/keepalived.conf 
global_defs { 
        router_id LVS_DEVEL
	script_user root
	enable_script_security
        vrrp_garp_master_refresh 30
        vrrp_garp_master_refresh_repeat 5
}   
vrrp_script check_apiserver {
    script "/etc/keepalived/ss.sh"
    interval 3
    weight 2
}

vrrp_instance VI_1 {
    state MASTER
    interface eth0
    virtual_router_id 120
    priority 100
    advert_int 2
    authentication {
        auth_type PASS
        auth_pass 1111
    }
    track_script {
      check_apiserver
    }
    virtual_ipaddress {
      10.204.51.120/24 dev eth0
    }
}

cat /etc/keepalived/ss.sh
#!/bin/bash
if ss -lnt | grep -q ":6443 "; then
   exit 0
else
   exit 1
fi
#        
systemctl start keepalived && systemctl enable keepalived

10.204.51.113

yum install -y keepalived
cat /etc/keepalived/keepalived.conf 
global_defs { 
    router_id LVS_DEVEL
    script_user root
    enable_script_security
    vrrp_garp_master_refresh 30
    vrrp_garp_master_refresh_repeat 5
}   
