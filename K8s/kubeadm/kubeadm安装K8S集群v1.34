a.安装基础依赖包
yum install wget jq psmisc vim net-tools telnet yum-utils device-mapper-persistent-data lvm2 git rsyslog nfs-utils -y

b.关闭防火墙，虚拟内存
systemctl disable --now firewalld 
systemctl disable --now dnsmasq
setenforce 0
sed -i 's#SELINUX=enforcing#SELINUX=disabled#g' /etc/selinux/config
systemctl enable --now rsyslog

swapoff -a && sysctl -w vm.swappiness=0
sed -ri '/^[^#]*swap/s@^@#@' /etc/fstab

dnf install epel-release -y
dnf config-manager --set-enabled epel

c.修改limit
vim /etc/security/limits.conf
# 末尾添加如下内容
* soft nofile 65536
* hard nofile 131072
* soft nproc 65535
* hard nproc 655350
* soft memlock unlimited
* hard memlock unlimited

d.配置IPVS模块
yum install ipvsadm ipset sysstat conntrack libseccomp -y
vim /etc/modules-load.d/ipvs.conf 
# 加入以下内容
ip_vs
ip_vs_lc
ip_vs_wlc
ip_vs_rr
ip_vs_wrr
ip_vs_lblc
ip_vs_lblcr
ip_vs_dh
ip_vs_sh
ip_vs_fo
ip_vs_nq
ip_vs_sed
ip_vs_ftp
ip_vs_sh
nf_conntrack
ip_tables
ip_set
xt_set
ipt_set
ipt_rpfilter
ipt_REJECT
ipip

---
systemctl enable --now systemd-modules-load.service
---
reboot
---
lsmod | grep --color=auto -e ip_vs -e nf_conntrack

e.安装containerd 
yum install wget jq psmisc vim net-tools telnet yum-utils device-mapper-persistent-data lvm2 git -y
yum-config-manager --add-repo https://mirrors.aliyun.com/docker-ce/linux/centos/docker-ce.repo
yum install docker-ce-29.6.1 docker-ce-cli-29.6.1  containerd.io-2.2.5 -y

docker 可以选装（建议安装）
cat <<EOF | sudo tee /etc/modules-load.d/containerd.conf
overlay
br_netfilter
EOF

----

modprobe -- overlay
modprobe -- br_netfilter

f.同步内核参数
cat  /etc/sysctl.conf 
vm.swappiness=10
vm.panic_on_oom=0
vm.overcommit_memory=1
vm.max_map_count=655360
user.max_user_namespaces=15000 
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_syncookies = 0
net.ipv4.tcp_synack_retries = 2
net.ipv4.tcp_retries2 = 5
net.ipv4.tcp_max_tw_buckets = 5000
net.ipv4.tcp_max_syn_backlog = 10240
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_probes = 10
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_fin_timeout = 30
net.ipv4.neigh.default.gc_thresh3 = 40960
net.ipv4.neigh.default.gc_thresh2 = 20480
net.ipv4.neigh.default.gc_thresh1 = 5120
net.ipv4.neigh.default.gc_stale_time = 120
net.ipv4.ip_local_port_range = 10000 65000
net.ipv4.ip_forward = 1
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.all.arp_ignore = 0
net.ipv4.conf.all.arp_announce = 2
net.netfilter.nf_conntrack_buckets=655360
net.netfilter.nf_conntrack_max=10485760
net.netfilter.nf_conntrack_tcp_timeout_established=300
net.netfilter.nf_conntrack_timestamp=1
net.netfilter.nf_conntrack_acct=1
net.netfilter.nf_conntrack_tcp_be_liberal=1
net.netfilter.nf_conntrack_tcp_loose=1
net.netfilter.nf_conntrack_tcp_timeout_time_wait=30
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.core.wmem_max = 262144
net.core.wmem_default = 262144
net.core.somaxconn = 10240
net.core.rmem_max = 1048576
net.core.rmem_default = 1048576
kernel.sysrq = 1
kernel.pid_max = 131072
fs.nr_open = 527069630
fs.inotify.max_user_watches=89100
fs.file-max = 65535600
----

sysctl -p


g.配置containerd
mkdir -p /etc/containerd
containerd config default | tee /etc/containerd/config.toml

ed -i 's#SystemdCgroup = false#SystemdCgroup = true#g' /etc/containerd/config.toml
sed -i 's#k8s.gcr.io/pause#registry.cn-hangzhou.aliyuncs.com/google_containers/pause#g'  /etc/containerd/config.toml
sed -i 's#registry.gcr.io/pause#registry.cn-hangzhou.aliyuncs.com/google_containers/pause#g'  /etc/containerd/config.toml
sed -i 's#registry.k8s.io/pause#registry.cn-hangzhou.aliyuncs.com/google_containers/pause#g'  /etc/containerd/config.toml
systemctl daemon-reload
systemctl enable --now containerd

cat > /etc/crictl.yaml <<EOF
runtime-endpoint: unix:///run/containerd/containerd.sock
image-endpoint: unix:///run/containerd/containerd.sock
timeout: 10
debug: false
EOF

h.配置私有仓库

mkdir -p /etc/containerd/certs.d/10.204.209.253
vim /etc/containerd/certs.d/10.204.209.253/hosts.toml

server = "http://10.204.209.253"
[host."http://10.204.209.253"]
  capabilities = ["pull", "resolve", "push"]   # 根据需要保留
  skip_verify = true                           # 如果使用 HTTP，可忽略 TLS 验证
  # 如果仓库需要认证，添加 auth 块
  [host."http://10.204.209.253".auth]
    username = "admin"
    password = "Admin@1qa"

将/etc/containerd/certs.d 下目录复制到其他所有节点
systemctl restart containerd

i.配置k8s源

cat <<EOF | tee /etc/yum.repos.d/kubernetes.repo
[kubernetes]
name=Kubernetes
baseurl=https://mirrors.aliyun.com/kubernetes-new/core/stable/v1.34/rpm/
enabled=1
gpgcheck=1
gpgkey=https://mirrors.aliyun.com/kubernetes-new/core/stable/v1.34/rpm/repodata/repomd.xml.key
EOF

j.安装kubeadm 
yum install -y kubeadm-1.34.9-0 kubelet-1.34.9-0 kubectl-1.34.9-0
yum install kubeadm-1.34* kubelet-1.34* kubectl-1.34* -y( 这个命令，会安装最新的1.34的小版本，但不影响）
systemctl daemon-reload
systemctl enable --now kubelet


k.配置时间同步
# 安装epel仓库源
dnf install epel-release -y
dnf config-manager --set-enabled epel
#  安装 chrony
dnf install -y chrony
# 启动并启用 chronyd 服务
systemctl enable --now chronyd
# 检查 chronyd 状态
systemctl status chronyd
# 检查时间同步状态
chronyc sources
# 查看系统时间
timedatectl status


